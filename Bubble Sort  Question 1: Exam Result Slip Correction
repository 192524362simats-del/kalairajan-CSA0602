def optimized_bubble_sort(roll_numbers):
    arr = roll_numbers.copy()
    n = len(arr)
    passes = 0

    # Optimized Bubble Sort
    for i in range(n - 1):
        swapped = False
        passes += 1

        # Compare adjacent elements
        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                # Swap adjacent elements
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        # If no swaps occurred, array is already sorted
        if not swapped:
            break

    return arr, passes


# Test Case 1: Nearly sorted roll numbers
sorted_rolls, passes = optimized_bubble_sort(
    [101, 102, 104, 103, 105, 107, 106, 108]
)

assert sorted_rolls == sorted(
    [101, 102, 104, 103, 105, 107, 106, 108]
)

assert passes < 8


# Test Case 2: Already sorted
sorted_ok, passes_ok = optimized_bubble_sort(
    [1, 2, 3, 4, 5]
)

assert passes_ok == 1


print("All test cases passed!")

# Display result
print("Sorted roll numbers:", sorted_rolls)
print("Number of passes:", passes)
