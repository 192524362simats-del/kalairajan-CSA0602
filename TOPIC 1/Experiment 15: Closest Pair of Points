# Closest Pair of Points

import math


# Calculate distance between two points

def distance(p1, p2):

    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )


# Brute Force Method

def brute_force(points):

    minimum_distance = float("inf")
    closest_pair = None

    for i in range(len(points)):

        for j in range(i + 1, len(points)):

            d = distance(points[i], points[j])

            if d < minimum_distance:
                minimum_distance = d
                closest_pair = (points[i], points[j])

    return closest_pair, minimum_distance


# Divide and Conquer Method

def closest_pair_recursive(points):

    n = len(points)

    if n <= 3:
        return brute_force(points)

    mid = n // 2

    left = points[:mid]
    right = points[mid:]

    left_pair, left_distance = closest_pair_recursive(left)
    right_pair, right_distance = closest_pair_recursive(right)

    if left_distance < right_distance:
        minimum_distance = left_distance
        closest_pair = left_pair
    else:
        minimum_distance = right_distance
        closest_pair = right_pair

    middle_x = points[mid][0]

    strip = []

    for point in points:
        if abs(point[0] - middle_x) < minimum_distance:
            strip.append(point)

    strip.sort(key=lambda p: p[1])

    for i in range(len(strip)):

        for j in range(i + 1, len(strip)):

            if strip[j][1] - strip[i][1] >= minimum_distance:
                break

            d = distance(strip[i], strip[j])

            if d < minimum_distance:
                minimum_distance = d
                closest_pair = (strip[i], strip[j])

    return closest_pair, minimum_distance


points = [
    (1, 2),
    (4, 5),
    (7, 8),
    (3, 1)
]

points.sort()

brute_pair, brute_distance = brute_force(points)

divide_pair, divide_distance = closest_pair_recursive(points)

print("Points:", points)

print()
print("Brute Force Method")
print("Closest pair:", brute_pair)
print("Distance:", brute_distance)

print()
print("Divide and Conquer Method")
print("Closest pair:", divide_pair)
print("Distance:", divide_distance)
