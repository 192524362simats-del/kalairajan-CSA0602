# Counting Inversions using Merge Sort

def merge_and_count(arr, left, mid, right):

    i = left
    j = mid + 1
    temp = []
    count = 0

    while i <= mid and j <= right:

        if arr[i] <= arr[j]:
            temp.append(arr[i])
            i = i + 1

        else:
            temp.append(arr[j])

            count = count + (mid - i + 1)

            j = j + 1

    while i <= mid:
        temp.append(arr[i])
        i = i + 1

    while j <= right:
        temp.append(arr[j])
        j = j + 1

    for k in range(len(temp)):
        arr[left + k] = temp[k]

    return count


def count_inversions(arr, left, right):

    count = 0

    if left < right:

        mid = (left + right) // 2

        count = count + count_inversions(arr, left, mid)

        count = count + count_inversions(arr, mid + 1, right)

        count = count + merge_and_count(arr, left, mid, right)

    return count


arr = [2, 4, 1, 3, 5]

print("Array:", arr)

result = count_inversions(arr, 0, len(arr) - 1)

print("Number of inversions:", result)
