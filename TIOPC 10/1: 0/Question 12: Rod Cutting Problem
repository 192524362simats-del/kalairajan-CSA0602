def rod_cut(price, n):
    # Create DP array
    dp = [0] * (n + 1)

    # Calculate maximum revenue for each length
    for i in range(1, n + 1):
        for j in range(i):
            dp[i] = max(
                dp[i],
                price[j] + dp[i - j - 1]
            )

    return dp[n]


price = [1, 5, 8, 9, 10, 17, 17, 20]
n = 8

print("Maximum Revenue =", rod_cut(price, n))
