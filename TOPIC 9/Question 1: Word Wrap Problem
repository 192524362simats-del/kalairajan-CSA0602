def min_wrap_cost(words, width):
    n = len(words)

    # dp[i] = minimum cost for wrapping words[i:]
    dp = [float('inf')] * (n + 1)

    # No words remaining = zero cost
    dp[n] = 0

    # Build DP from right to left
    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            # Add the current word and one space before it
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            # Stop if the words do not fit
            if line_length > width:
                break

            # Last line has no penalty
            if j == n - 1:
                current_cost = 0
            else:
                extra_spaces = width - line_length
                current_cost = extra_spaces ** 2

            dp[i] = min(dp[i], current_cost + dp[j + 1])

    return dp[0]


# Test Cases
assert min_wrap_cost([3, 2, 2, 5], 6) == 19
assert min_wrap_cost([3], 6) == 0

