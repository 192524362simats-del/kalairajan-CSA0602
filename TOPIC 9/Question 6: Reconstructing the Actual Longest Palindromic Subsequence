def reconstruct_lps(s):
    n = len(s)

    # Empty string
    if n == 0:
        return ""

    # Create DP table
    dp = [[0] * n for _ in range(n)]

    # A single character is a palindrome of length 1
    for i in range(n):
        dp[i][i] = 1

    # Fill the DP table
    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1

            if s[i] == s[j]:
                if length == 2:
                    dp[i][j] = 2
                else:
                    dp[i][j] = dp[i + 1][j - 1] + 2
            else:
                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])

    # Backtracking to reconstruct the LPS
    i = 0
    j = n - 1

    left = []
    right = []

    while i <= j:
        if i == j:
            # Middle character of an odd-length palindrome
            left.append(s[i])
            break

        if s[i] == s[j]:
            # Include both matching characters
            left.append(s[i])
            right.append(s[j])
            i += 1
            j -= 1

        elif dp[i + 1][j] >= dp[i][j - 1]:
            # Move down: drop the left character
            i += 1

        else:
            # Move left: drop the right character
            j -= 1

    # Combine the two halves
    return "".join(left) + "".join(reversed(right))


# Test Cases
assert reconstruct_lps("bbbab") == "bbbb"
assert reconstruct_lps("cbbd") == "bb"

print("All test cases passed!")


# Example
s1 = "bbbab"
s2 = "cbbd"

print(f"{s1} -> {reconstruct_lps(s1)}")
print(f"{s2} -> {reconstruct_lps(s2)}")
