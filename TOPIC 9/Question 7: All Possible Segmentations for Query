def all_segmentations(s, dictionary):
    word_set = set(dictionary)
    n = len(s)

    # Step 1: Boolean DP to identify feasible prefixes
    dp = [False] * (n + 1)
    dp[0] = True

    for i in range(1, n + 1):
        for j in range(i):
            if dp[j] and s[j:i] in word_set:
                dp[i] = True
                break

    # If the complete string cannot be segmented
    if not dp[n]:
        return []

    # Step 2: Memoized recursion
    memo = {}

    def backtrack(start):
        if start == n:
            return [""]

        if start in memo:
            return memo[start]

        results = []

        for end in range(start + 1, n + 1):
            word = s[start:end]

            if word in word_set and dp[end]:
                suffix_results = backtrack(end)

                for suffix in suffix_results:
                    if suffix:
                        results.append(word + " " + suffix)
                    else:
                        results.append(word)

        memo[start] = results
        return results

    return backtrack(0)


# Test Cases
result = all_segmentations(
    "catsanddog",
    ["cats", "cat", "and", "sand", "dog"]
)

assert "cats and dog" in result
assert "cat sand dog" in result
assert len(result) == 2

print("All test cases passed!")

# Display all possible segmentations
print("\nPossible segmentations:")
for segmentation in result:
    print(segmentation)
