def min_segments(s, dictionary):
    n = len(s)
    word_set = set(dictionary)

    # dp[i] = minimum number of words needed
    # to form s[0:i]
    dp = [float('inf')] * (n + 1)
    dp[0] = 0

    for i in range(1, n + 1):
        for j in range(i):
            if dp[j] != float('inf') and s[j:i] in word_set:
                dp[i] = min(dp[i], dp[j] + 1)

    # If the string cannot be segmented
    if dp[n] == float('inf'):
        return None

    return dp[n]


# Test Cases
assert min_segments("applepenapple", ["apple", "pen"]) == 3
assert min_segments("catsandog", ["cats", "dog", "sand", "and", "cat"]) is None

print("All test cases passed!")
