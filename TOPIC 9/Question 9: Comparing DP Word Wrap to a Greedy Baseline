def min_wrap_cost(words, width):
    n = len(words)

    dp = [float('inf')] * (n + 1)
    dp[n] = 0

    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            if line_length > width:
                break

            # Last line has no penalty
            if j == n - 1:
                cost = 0
            else:
                extra_space = width - line_length
                cost = extra_space ** 2

            dp[i] = min(dp[i], cost + dp[j + 1])

    return dp[0]


def greedy_wrap_cost(words, width):
    n = len(words)
    total_cost = 0
    i = 0

    while i < n:
        line_length = words[i]
        j = i + 1

        # Fill the current line as much as possible
        while j < n and line_length + 1 + words[j] <= width:
            line_length += 1 + words[j]
            j += 1

        # Last line has no penalty
        if j < n:
            extra_space = width - line_length
            total_cost += extra_space ** 2

        i = j

    return total_cost


def greedy_wrap_lines(words, width):
    lines = []
    i = 0
    n = len(words)

    while i < n:
        line = [words[i]]
        line_length = words[i]
        i += 1

        while i < n and line_length + 1 + words[i] <= width:
            line.append(words[i])
            line_length += 1 + words[i]
            i += 1

        lines.append(line)

    return lines


# Test case
words = [3, 2, 2, 5]
width = 6

dp_cost = min_wrap_cost(words, width)
greedy_cost = greedy_wrap_cost(words, width)

print("DP cost:", dp_cost)
print("Greedy cost:", greedy_cost)

print("DP <= Greedy:", dp_cost <= greedy_cost)

assert dp_cost <= greedy_cost

# Standard Word Wrap result
assert min_wrap_cost([3, 2, 2, 5], 6) == 10

print("All test cases passed!")
