def is_weak_password(password, threshold=0.6):
    n = len(password)

    # Empty password is considered weak
    if n == 0:
        return True

    # Rolling rows for LPS calculation
    prev = [0] * n
    curr = [0] * n

    # Every single character is an LPS of length 1
    for i in range(n):
        prev[i] = 1

    # Calculate LPS
    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1

            if password[i] == password[j]:
                if length == 2:
                    curr[i] = 2
                else:
                    curr[i] = prev[i + 1] + 2
            else:
                curr[i] = max(prev[i], curr[i + 1])

        # Move to the next row
        prev, curr = curr, [0] * n

    # LPS length
    lps = prev[0]

    # Calculate ratio of palindromic structure
    lps_ratio = lps / n

    # Flag if ratio meets or exceeds threshold
    return lps_ratio >= threshold


# Test Cases
assert is_weak_password("bbbab", threshold=0.6) == True
assert is_weak_password("cbbd", threshold=0.6) == False

print("All test cases passed!")


# Example usage
passwords = ["bbbab", "cbbd"]

for password in passwords:
    result = is_weak_password(password, threshold=0.6)

    if result:
        print(f"{password}: WEAK - Flagged for review")
    else:
        print(f"{password}: ACCEPTABLE - Not flagged")
