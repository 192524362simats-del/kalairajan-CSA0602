def lps_length(s):
    """Calculate LPS using direct palindrome DP."""
    n = len(s)

    if n == 0:
        return 0

    # DP table
    dp = [[0] * n for _ in range(n)]

    # Single characters are palindromes of length 1
    for i in range(n):
        dp[i][i] = 1

    # Fill table by increasing substring length
    for length in range(2, n + 1):
        for i in range(n - length + 1):
            j = i + length - 1

            if s[i] == s[j]:
                if length == 2:
                    dp[i][j] = 2
                else:
                    dp[i][j] = dp[i + 1][j - 1] + 2
            else:
                dp[i][j] = max(dp[i + 1][j], dp[i][j - 1])

    return dp[0][n - 1]


def lcs_length(a, b):
    """Calculate LCS length using standard two-string DP."""
    m = len(a)
    n = len(b)

    # DP table
    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Fill the LCS table
    for i in range(1, m + 1):
        for j in range(1, n + 1):

            if a[i - 1] == b[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                dp[i][j] = max(
                    dp[i - 1][j],
                    dp[i][j - 1]
                )

    return dp[m][n]


def compare_lps_lcs(s):
    """Compare direct LPS with LCS(s, reverse(s))."""

    direct_lps = lps_length(s)

    reversed_s = s[::-1]
    lcs_result = lcs_length(s, reversed_s)

    print(f"String: {s}")
    print(f"Reverse: {reversed_s}")
    print(f"Direct LPS Length: {direct_lps}")
    print(f"LCS(s, reverse(s)) Length: {lcs_result}")

    if direct_lps == lcs_result:
        print("Result: Both methods give the same answer.")
    else:
        print("Result: The answers are different.")

    return direct_lps, lcs_result


# Test Cases
assert lps_length("bbbab") == lcs_length("bbbab", "bbbab"[::-1])
assert lps_length("cbbd") == lcs_length("cbbd", "cbbd"[::-1])

print("All test cases passed!")

# Demonstration
print("\n--- Comparison 1 ---")
compare_lps_lcs("bbbab")

print("\n--- Comparison 2 ---")
compare_lps_lcs("cbbd")
