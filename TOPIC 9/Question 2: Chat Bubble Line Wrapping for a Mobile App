def min_wrap_cost(words, width):
    n = len(words)

    dp = [float('inf')] * (n + 1)
    choice = [-1] * n

    dp[n] = 0

    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            # Words do not fit on this line
            if line_length > width:
                break

            # Last line has no penalty
            if j == n - 1:
                cost = 0
            else:
                extra_spaces = width - line_length
                cost = extra_spaces ** 2

            total_cost = cost + dp[j + 1]

            if total_cost < dp[i]:
                dp[i] = total_cost
                choice[i] = j

    return dp[0]


def wrap_lines(words, width):
    n = len(words)

    dp = [float('inf')] * (n + 1)
    choice = [-1] * n

    dp[n] = 0

    # DP calculation
    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            if line_length > width:
                break

            if j == n - 1:
                cost = 0
            else:
                extra_spaces = width - line_length
                cost = extra_spaces ** 2

            total_cost = cost + dp[j + 1]

            if total_cost < dp[i]:
                dp[i] = total_cost
                choice[i] = j

    # Reconstruct lines
    lines = []
    i = 0

    while i < n:
        j = choice[i]
        lines.append(words[i:j + 1])
        i = j + 1

    return lines


# Test Cases
assert min_wrap_cost([3, 2, 2, 5], 6) == 10

lines = wrap_lines([3, 2, 2, 5], 6)

assert sum(len(line) for line in lines) == 4

print("Lines:", lines)
print("All test cases passed!")
