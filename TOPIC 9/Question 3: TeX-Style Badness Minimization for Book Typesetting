def min_badness(words, width):
    n = len(words)

    # dp[i] = minimum badness for words[i:]
    dp = [float('inf')] * (n + 1)

    # No words left
    dp[n] = 0

    # Calculate from right to left
    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            # Add word length and space between words
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            # Stop if line exceeds width
            if line_length > width:
                break

            # Last line has no badness
            if j == n - 1:
                cost = 0
            else:
                extra_spaces = width - line_length
                cost = extra_spaces ** 2

            dp[i] = min(dp[i], cost + dp[j + 1])

    return dp[0]


# Test Cases
assert min_badness([3, 2, 2, 5], 6) == 10
assert min_badness([3], 6) == 0

print("Minimum badness:", min_badness([3, 2, 2, 5], 6))
print("All test cases passed!")
