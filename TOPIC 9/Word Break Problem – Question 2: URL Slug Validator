def can_segment(s, dictionary):
    n = len(s)

    # Convert dictionary to a set for fast lookup
    word_set = set(dictionary)

    # dp[i] = True if s[0:i] can be segmented
    dp = [False] * (n + 1)

    # Empty prefix can always be segmented
    dp[0] = True

    # Check every ending position
    for i in range(1, n + 1):

        # Try every possible split point
        for j in range(i):

            if dp[j] and s[j:i] in word_set:
                dp[i] = True
                break

    return dp[n]


def validate_slug(slug, keyword_dictionary):
    # Remove hyphens from the URL slug
    stripped_slug = slug.replace("-", "")

    # Check whether it can be segmented into keywords
    return can_segment(stripped_slug, keyword_dictionary)


# Test Cases
assert can_segment("leetcode", ["leet", "code"]) == True

assert can_segment(
    "catsandog",
    ["cats", "dog", "sand", "and", "cat"]
) == False

print("All test cases passed!")


# Example URL slugs
keywords = ["leet", "code", "cats", "and", "dog", "sand", "cat"]

slug1 = "leet-code"
slug2 = "cats-and-dog"
slug3 = "cats-and-og"

print("\nURL Slug Validation:")

for slug in [slug1, slug2, slug3]:
    if validate_slug(slug, keywords):
        print(f"{slug} -> Valid slug")
    else:
        print(f"{slug} -> Flagged for manual review")
