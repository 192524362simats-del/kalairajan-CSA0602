def min_wrap_cost(words, width):
    n = len(words)

    dp = [float('inf')] * (n + 1)
    dp[n] = 0

    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            if line_length > width:
                break

            # Last line has no penalty
            if j == n - 1:
                cost = 0
            else:
                extra_space = width - line_length
                cost = extra_space ** 2

            dp[i] = min(dp[i], cost + dp[j + 1])

    return dp[0]


def wrap_lines(words, width):
    n = len(words)

    dp = [float('inf')] * (n + 1)
    choice = [-1] * n
    dp[n] = 0

    for i in range(n - 1, -1, -1):
        line_length = 0

        for j in range(i, n):
            if j == i:
                line_length = words[j]
            else:
                line_length += 1 + words[j]

            if line_length > width:
                break

            if j == n - 1:
                cost = 0
            else:
                extra_space = width - line_length
                cost = extra_space ** 2

            total_cost = cost + dp[j + 1]

            if total_cost < dp[i]:
                dp[i] = total_cost
                choice[i] = j

    # Reconstruct lines
    lines = []
    i = 0

    while i < n:
        j = choice[i]
        lines.append(words[i:j + 1])
        i = j + 1

    return lines


def reflow_panel(words, old_width, new_width, previous_lines):
    # Calculate the optimal cost for the new width
    new_cost = min_wrap_cost(words, new_width)

    # Check whether the old layout still fits
    old_layout_fits = all(
        sum(line) + len(line) - 1 <= new_width
        for line in previous_lines
    )

    # Reflow if the old layout no longer fits
    # or if the width changed significantly
    if not old_layout_fits or old_width != new_width:
        new_lines = wrap_lines(words, new_width)
        return new_lines, new_cost

    return previous_lines, new_cost


# Test case
words = [3, 2, 2, 5]

initial_width = 6
initial_lines = wrap_lines(words, initial_width)

# Resize panel
new_width = 7

new_lines, new_cost = reflow_panel(
    words,
    initial_width,
    new_width,
    initial_lines
)

print("Initial layout:", initial_lines)
print("New layout:", new_lines)
print("New minimum cost:", new_cost)

# Standard Word Wrap test
assert min_wrap_cost([3, 2, 2, 5], 6) == 10

assert all(
    sum(line) + len(line) - 1 <= 6
    for line in wrap_lines([3, 2, 2, 5], 6)
)

print("All test cases passed!")
