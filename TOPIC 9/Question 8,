def can_segment(s, dictionary):
    word_set = set(dictionary)
    n = len(s)

    # dp[i] = True if s[0:i] can be segmented
    dp = [False] * (n + 1)
    dp[0] = True

    for i in range(1, n + 1):
        for j in range(i):
            if dp[j] and s[j:i] in word_set:
                dp[i] = True
                break

    return dp[n]


def all_segmentations(s, dictionary):
    word_set = set(dictionary)
    n = len(s)

    memo = {}

    def backtrack(start):
        if start == n:
            return [""]

        if start in memo:
            return memo[start]

        results = []

        for end in range(start + 1, n + 1):
            word = s[start:end]

            if word in word_set:
                for suffix in backtrack(end):
                    if suffix:
                        results.append(word + " " + suffix)
                    else:
                        results.append(word)

        memo[start] = results
        return results

    return backtrack(0)


def enumerate_if_possible(s, dictionary):
    # Step 1: Cheap feasibility check
    if not can_segment(s, dictionary):
        return []

    # Step 2: Only enumerate if feasible
    return all_segmentations(s, dictionary)


# Test Cases
assert can_segment(
    "catsandog",
    ["cats", "dog", "sand", "and", "cat"]
) == False

assert can_segment(
    "catsanddog",
    ["cats", "cat", "and", "sand", "dog"]
) == True

print("All test cases passed!")


# Demonstration
dictionary = ["cats", "cat", "and", "sand", "dog"]

print("\nInvalid input:")
print(enumerate_if_possible("catsandog", dictionary))

print("\nValid input:")
print(enumerate_if_possible("catsanddog", dictionary))
