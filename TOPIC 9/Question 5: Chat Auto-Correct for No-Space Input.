def suggest_spacing(s, dictionary):
    n = len(s)
    word_set = set(dictionary)

    # dp[i] tells whether s[0:i] can be segmented
    dp = [False] * (n + 1)

    # parent[i] stores the previous split position
    parent = [-1] * (n + 1)

    dp[0] = True

    # Fill the DP table
    for i in range(1, n + 1):
        for j in range(i):
            if dp[j] and s[j:i] in word_set:
                dp[i] = True
                parent[i] = j
                break

    # If the complete string cannot be segmented
    if not dp[n]:
        return None

    # Backtrack to recover the words
    words = []
    position = n

    while position > 0:
        start = parent[position]
        words.append(s[start:position])
        position = start

    # Reverse the words and insert spaces
    words.reverse()

    return " ".join(words)


# Test Cases
assert suggest_spacing("leetcode", ["leet", "code"]) == "leet code"
assert suggest_spacing(
    "catsandog",
    ["cats", "dog", "sand", "and", "cat"]
) is None

print("All test cases passed!")
