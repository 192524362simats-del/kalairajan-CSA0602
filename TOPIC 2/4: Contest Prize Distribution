def distribute_prizes(participants):
    n = len(participants)
    ranking = participants.copy()

    for i in range(n - 1):
        max_index = i

        # Find the participant with the highest score
        for j in range(i + 1, n):
            if ranking[j][1] > ranking[max_index][1]:
                max_index = j

        # Swap the highest scorer into the current position
        if max_index != i:
            ranking[i], ranking[max_index] = ranking[max_index], ranking[i]

        # Print the next-ranked participant
        print(f"Rank {i + 1}: {ranking[i][0]} - {ranking[i][1]}")

    # Print the last participant
    if n > 0:
        print(f"Rank {n}: {ranking[n - 1][0]} - {ranking[n - 1][1]}")

    return ranking


# Test Case
participants = [
    ('Asha', 88),
    ('Ravi', 95),
    ('Meera', 79),
    ('Dev', 95)
]

ranking = distribute_prizes(participants)

scores_only = [p[1] for p in ranking]

assert scores_only == sorted(scores_only, reverse=True)
assert ranking[0][1] == 95

print("\nFinal Ranking:")
for rank, (name, score) in enumerate(ranking, start=1):
    print(f"{rank}. {name} - {score}")

print("\nAll test cases passed!")
