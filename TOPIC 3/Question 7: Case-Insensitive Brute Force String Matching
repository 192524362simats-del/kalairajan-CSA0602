 # Brute Force String Matching - Case-Insensitive Search

text = "DataStructuresAndAlgorithms"
pattern = "ALGORITHMS"

# Convert both text and pattern to lowercase
text_lower = text.lower()
pattern_lower = pattern.lower()

n = len(text_lower)
m = len(pattern_lower)

position = -1

for i in range(n - m + 1):
    j = 0

    while j < m and text_lower[i + j] == pattern_lower[j]:
        j += 1

    if j == m:
        position = i + 1   # 1-based position
        break

if position != -1:
    print("Pattern found at position", position)
else:
    print("Pattern not found")
