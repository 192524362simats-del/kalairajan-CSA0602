def karatsuba_with_count(x, y, counter):
    """
    Karatsuba multiplication with recursive call counting.
    counter[0] stores the total number of calls.
    """

    # Count every function call, including base cases
    counter[0] += 1

    # Base case
    if x < 10 or y < 10:
        return x * y

    # Number of digits
    n = max(len(str(x)), len(str(y)))
    m = n // 2

    # Split x and y
    power = 10 ** m

    high_x = x // power
    low_x = x % power

    high_y = y // power
    low_y = y % power

    # Three recursive multiplications
    z2 = karatsuba_with_count(high_x, high_y, counter)
    z0 = karatsuba_with_count(low_x, low_y, counter)

    z1 = karatsuba_with_count(
        high_x + low_x,
        high_y + low_y,
        counter
    )

    # z1 = (high_x + low_x)(high_y + low_y)
    z1 = z1 - z2 - z0

    # Combine the results
    result = (
        z2 * (10 ** (2 * m))
        + z1 * (10 ** m)
        + z0
    )

    return result


def schoolbook_multiplications(n):
    """
    Number of digit-level multiplications
    required by schoolbook multiplication.
    """
    return n * n


