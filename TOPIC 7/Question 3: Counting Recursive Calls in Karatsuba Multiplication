# ---------------------------------------------------------
# Compare Increasing Digit Lengths
# ---------------------------------------------------------

print("\nGrowth Comparison")
print("-----------------")
print("Digits | Karatsuba Calls | Schoolbook Multiplications")

for digits in [2, 4, 8, 16, 32]:

    x = int('7' * digits)
    y = int('3' * digits)

    counter = [0]

    result = karatsuba_with_count(x, y, counter)

    assert result == x * y

    schoolbook_count = schoolbook_multiplications(digits)

    print(
        f"{digits:6} | "
        f"{counter[0]:16} | "
        f"{schoolbook_count:25}"
    )

