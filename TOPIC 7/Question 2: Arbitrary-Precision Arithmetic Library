for digits in [2, 4, 8, 16, 32]:

    x = '7' * digits
    y = '3' * digits

    schoolbook_result = schoolbook_multiply(x, y)
    karatsuba_result = karatsuba(x, y)

    # Verify both algorithms
    assert schoolbook_result == str(int(x) * int(y))
    assert karatsuba_result == str(int(x) * int(y))

    print(f"\nDigits: {digits}")
    print(f"x = {x}")
