#include <stdio.h>
#include <stdlib.h>
#include <time.h>

#define MAX 128

/* Standard matrix multiplication */
void standardMultiply(int n, int A[MAX][MAX],
                      int B[MAX][MAX],
                      int C[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {

            C[i][j] = 0;

            for (int k = 0; k < n; k++) {
                C[i][j] += A[i][k] * B[k][j];
            }
        }
    }
}

/* Matrix addition */
void addMatrix(int n, int A[MAX][MAX],
               int B[MAX][MAX],
               int C[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            C[i][j] = A[i][j] + B[i][j];
        }
    }
}

/* Matrix subtraction */
void subtractMatrix(int n, int A[MAX][MAX],
                    int B[MAX][MAX],
                    int C[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            C[i][j] = A[i][j] - B[i][j];
        }
    }
}

/*
   Hybrid Strassen Algorithm

   If n <= threshold:
       Use standard multiplication.

   Otherwise:
       Continue Strassen recursion.
*/
void strassenHybrid(int n,
                    int A[MAX][MAX],
                    int B[MAX][MAX],
                    int C[MAX][MAX],
                    int threshold) {

    /* Base case / threshold tuning */
    if (n <= threshold) {
        standardMultiply(n, A, B, C);
        return;
    }

    int mid = n / 2;

    int A11[MAX][MAX], A12[MAX][MAX];
    int A21[MAX][MAX], A22[MAX][MAX];

    int B11[MAX][MAX], B12[MAX][MAX];
    int B21[MAX][MAX], B22[MAX][MAX];

    int M1[MAX][MAX], M2[MAX][MAX];
    int M3[MAX][MAX], M4[MAX][MAX];
    int M5[MAX][MAX], M6[MAX][MAX], M7[MAX][MAX];

    int T1[MAX][MAX], T2[MAX][MAX];

    /* Divide A and B into four submatrices */
    for (int i = 0; i < mid; i++) {
        for (int j = 0; j < mid; j++) {

            A11[i][j] = A[i][j];
            A12[i][j] = A[i][j + mid];

            A21[i][j] = A[i + mid][j];
            A22[i][j] = A[i + mid][j + mid];

            B11[i][j] = B[i][j];
            B12[i][j] = B[i][j + mid];

            B21[i][j] = B[i + mid][j];
            B22[i][j] = B[i + mid][j + mid];
        }
    }

    /* M1 = (A11 + A22)(B11 + B22) */
    addMatrix(mid, A11, A22, T1);
    addMatrix(mid, B11, B22, T2);

    strassenHybrid(mid, T1, T2, M1, threshold);

    /* M2 = (A21 + A22)B11 */
    addMatrix(mid, A21, A22, T1);

    strassenHybrid(mid, T1, B11, M2, threshold);

    /* M3 = A11(B12 - B22) */
    subtractMatrix(mid, B12, B22, T1);

    strassenHybrid(mid, A11, T1, M3, threshold);

    /* M4 = A22(B21 - B11) */
    subtractMatrix(mid, B21, B11, T1);

    strassenHybrid(mid, A22, T1, M4, threshold);

    /* M5 = (A11 + A12)B22 */
    addMatrix(mid, A11, A12, T1);

    strassenHybrid(mid, T1, B22, M5, threshold);

    /* M6 = (A21 - A11)(B11 + B12) */
    subtractMatrix(mid, A21, A11, T1);
    addMatrix(mid, B11, B12, T2);

    strassenHybrid(mid, T1, T2, M6, threshold);

    /* M7 = (A12 - A22)(B21 + B22) */
    subtractMatrix(mid, A12, A22, T1);
    addMatrix(mid, B21, B22, T2);

    strassenHybrid(mid, T1, T2, M7, threshold);

    /* Combine results */

    for (int i = 0; i < mid; i++) {
        for (int j = 0; j < mid; j++) {

            /* C11 = M1 + M4 - M5 + M7 */
            C[i][j] =
                M1[i][j] + M4[i][j]
                - M5[i][j] + M7[i][j];

            /* C12 = M3 + M5 */
            C[i][j + mid] =
                M3[i][j] + M5[i][j];

            /* C21 = M2 + M4 */
            C[i + mid][j] =
                M2[i][j] + M4[i][j];

            /* C22 = M1 - M2 + M3 + M6 */
            C[i + mid][j + mid] =
                M1[i][j] - M2[i][j]
                + M3[i][j] + M6[i][j];
        }
    }
}

/* Generate random matrix */
void randomMatrix(int n, int A[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            A[i][j] = (rand() % 11) - 5;
        }
    }
}

/* Compare two matrices */
int compareMatrices(int n,
                    int A[MAX][MAX],
                    int B[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {

            if (A[i][j] != B[i][j]) {
                return 0;
            }
        }
    }

    return 1;
}

/* Print matrix */
void printMatrix(int n, int A[MAX][MAX]) {

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("%d ", A[i][j]);
        }
        printf("\n");
    }
}

int main() {

    srand((unsigned int)time(NULL));

    int n = 4;

    int A[MAX][MAX];
    int B[MAX][MAX];

    int C_standard[MAX][MAX];
    int C_hybrid[MAX][MAX];

    /* Generate random matrices */
    randomMatrix(n, A);
    randomMatrix(n, B);

    printf("Matrix A:\n");
    printMatrix(n, A);

    printf("\nMatrix B:\n");
    printMatrix(n, B);

    /*
       Test Case 1:
       threshold = 2
    */
    strassenHybrid(n, A, B, C_hybrid, 2);

    standardMultiply(n, A, B, C_standard);

    printf("\nTest Case 1: Threshold = 2\n");

    printf("\nHybrid Strassen Result:\n");
    printMatrix(n, C_hybrid);

    printf("\nStandard Multiplication Result:\n");
    printMatrix(n, C_standard);

    if (compareMatrices(n, C_hybrid, C_standard))
        printf("\nTest Case 1: Passed\n");
    else
        printf("\nTest Case 1: Failed\n");


    /*
       Test Case 2:
       threshold = 4

       Since threshold == matrix size,
       standard multiplication is used immediately.
    */
    strassenHybrid(n, A, B, C_hybrid, 4);

    printf("\nTest Case 2: Threshold = 4\n");

    printf("\nHybrid Strassen Result:\n");
    printMatrix(n, C_hybrid);

    if (compareMatrices(n, C_hybrid, C_standard))
        printf("\nTest Case 2: Passed\n");
    else
        printf("\nTest Case 2: Failed\n");


    printf("\nAll test cases passed!\n");

    return 0;
}
