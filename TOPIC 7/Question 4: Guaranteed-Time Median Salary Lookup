import random

random.seed(1)

big_data = [
    random.randint(0, 10000)
    for _ in range(500)
]

sorted_big = sorted(big_data)

for k in [0, 10, 250, 499]:
    assert median_of_medians_select(big_data, k) == sorted_big[k]


