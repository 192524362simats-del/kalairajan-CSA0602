import math
import random


# ---------------------------------------------------------
# Calculate Euclidean Distance
# ---------------------------------------------------------

def distance(p1, p2):
    return math.sqrt(
        (p1[0] - p2[0]) ** 2 +
        (p1[1] - p2[1]) ** 2
    )


# ---------------------------------------------------------
# Brute Force Method
# Used for verification
# ---------------------------------------------------------

def brute_force_closest(points):
    min_dist = float("inf")
    best_pair = None

    n = len(points)

    for i in range(n):
        for j in range(i + 1, n):

            d = distance(points[i], points[j])

            if d < min_dist:
                min_dist = d
                best_pair = (points[i], points[j])

    return best_pair, min_dist


# ---------------------------------------------------------
# Closest Pair in Small Set
# ---------------------------------------------------------

def closest_pair_brute(points):
    min_dist = float("inf")
    best_pair = None

    for i in range(len(points)):
        for j in range(i + 1, len(points)):

            d = distance(points[i], points[j])

            if d < min_dist:
                min_dist = d
                best_pair = (points[i], points[j])

    return best_pair, min_dist


# ---------------------------------------------------------
# Divide-and-Conquer Closest Pair
# ---------------------------------------------------------

def closest_pair_recursive(points_x, points_y):

    n = len(points_x)

    # Base case
    if n <= 3:
        return closest_pair_brute(points_x)

    # Divide
    mid = n // 2
    left_x = points_x[:mid]
    right_x = points_x[mid:]

    mid_x = points_x[mid][0]

    # Divide points sorted by y-coordinate
    left_set = set(left_x)

    left_y = []
    right_y = []

    for point in points_y:
        if point in left_set:
            left_y.append(point)
        else:
            right_y.append(point)

    # Recursive calls
    pair_left, dist_left = closest_pair_recursive(
        left_x, left_y
    )

    pair_right, dist_right = closest_pair_recursive(
        right_x, right_y
    )

    # Select smaller distance
    if dist_left < dist_right:
        min_dist = dist_left
        best_pair = pair_left
    else:
        min_dist = dist_right
        best_pair = pair_right

    # -----------------------------------------------------
    # Construct strip
    # -----------------------------------------------------

    strip = [
        point for point in points_y
        if abs(point[0] - mid_x) < min_dist
    ]

    # Check points in strip
    for i in range(len(strip)):

        j = i + 1

        while j < len(strip) and \
              (strip[j][1] - strip[i][1]) < min_dist:

            d = distance(strip[i], strip[j])

            if d < min_dist:
                min_dist = d
                best_pair = (strip[i], strip[j])

            j += 1

    return best_pair, min_dist


# ---------------------------------------------------------
# Main Closest Pair Function
# ---------------------------------------------------------

def closest_pair_of_points(points):

    if len(points) < 2:
        raise ValueError("At least two points are required.")

    # Sort by x-coordinate
    points_x = sorted(points, key=lambda p: p[0])

    # Sort by y-coordinate
    points_y = sorted(points, key=lambda p: p[1])

    return closest_pair_recursive(points_x, points_y)


# ---------------------------------------------------------
# Test Case 1
# ---------------------------------------------------------

pts = [
    (2, 3),
    (12, 30),
    (40, 50),
    (5, 1),
    (12, 10),
    (3, 4)
]

pair, d = closest_pair_of_points(pts)

brute_pair, brute_d = brute_force_closest(pts)

assert abs(d - brute_d) < 1e-9

print("Test Case 1")
print("------------")
print("Points:", pts)
print("Closest Pair:", pair)
print("Distance:", d)
print("Brute Force Distance:", brute_d)


