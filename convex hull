#include <stdio.h>

struct Point {
    int x, y;
};

int main() {

    struct Point p[] = {
        {0,0}, {2,7}, {5,9}, {8,7},
        {10,3}, {7,0}, {3,1}, {5,4}
    };

    int n = 8;
    int comparisons = 0;

    printf("Convex Hull Edges:\n\n");

    // Brute Force Convex Hull
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {

            int pos = 0, neg = 0;

            for (int k = 0; k < n; k++) {

                if (k == i || k == j)
                    continue;

                comparisons++;

                int cross =
                    (p[j].x - p[i].x) * (p[k].y - p[i].y) -
                    (p[j].y - p[i].y) * (p[k].x - p[i].x);

                if (cross > 0)
                    pos++;
                else if (cross < 0)
                    neg++;
            }

            // If all points lie on one side, edge belongs to hull
            if (pos == 0 || neg == 0) {
                printf("(%d,%d) --> (%d,%d)\n",
                       p[i].x, p[i].y,
                       p[j].x, p[j].y);
            }
        }
    }

    printf("\nTotal Comparisons = %d\n", comparisons);
    printf("Time Complexity = O(n^3)\n");

    return 0;
}
