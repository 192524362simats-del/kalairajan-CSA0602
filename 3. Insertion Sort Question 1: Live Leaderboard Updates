def insertion_sort_leaderboard(scores):
    # Make a copy so the original list is not modified
    leaderboard = scores.copy()

    # Start from the second element
    for i in range(1, len(leaderboard)):
        key = leaderboard[i]
        j = i - 1

        # Shift smaller elements to the right
        while j >= 0 and leaderboard[j] < key:
            leaderboard[j + 1] = leaderboard[j]
            j -= 1

        # Insert the new score
        leaderboard[j + 1] = key

    return leaderboard


# Test Case 1
scores = [85, 92, 78, 95, 88]

result = insertion_sort_leaderboard(scores)

assert result == [95, 92, 88, 85, 78]


# Test Case 2: Already sorted leaderboard
result2 = insertion_sort_leaderboard([100, 90, 80, 70])

assert result2 == [100, 90, 80, 70]


# Test Case 3: Single score
result3 = insertion_sort_leaderboard([75])

assert result3 == [75]


print("All test cases passed!")

print("Original scores:", scores)
print("Updated leaderboard:", result)
