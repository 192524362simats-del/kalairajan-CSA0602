def pick_up_card(hand, card):
    """
    Insert a newly picked card into its correct position
    in an already sorted hand using insertion sort logic.
    """

    # Add the new card at the end
    hand.append(card)

    # Start from the newly added card
    i = len(hand) - 1

    # Shift larger cards to the right
    while i > 0 and hand[i - 1] > hand[i]:
        hand[i], hand[i - 1] = hand[i - 1], hand[i]
        i -= 1

    return hand


# Test Case 1
hand = []

for card in [7, 2, 9, 4, 1]:
    hand = pick_up_card(hand, card)

assert hand == sorted([7, 2, 9, 4, 1])

# Test Case 2: First card
assert pick_up_card([], 5) == [5]

print("All test cases passed!")
print("Final sorted hand:", hand)
