# Fibonacci Series - Iterative and Recursive

# Iterative Method
def fibonacci_iterative(n):
    series = []
    a, b = 0, 1

    for i in range(n):
        series.append(a)
        a, b = b, a + b

    return series


# Recursive Method
def fibonacci_recursive(n):
    if n <= 1:
        return n
    return fibonacci_recursive(n - 1) + fibonacci_recursive(n - 2)


# Sample Input
n = 6

print("Iterative Fibonacci Series:")
print(fibonacci_iterative(n))

print("\nRecursive Fibonacci Series:")
recursive_series = []
for i in range(n):
    recursive_series.append(fibonacci_recursive(i))
print(recursive_series)
