#include <stdio.h>

int factorial(int n)
{
    int fact = 1;

    for (int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main()
{
    int n = 15;
    int r = 5;

    int selections = factorial(n) /
                      (factorial(r) * factorial(n - r));

    printf("Total Players = %d\n", n);
    printf("Players Required = %d\n", r);
    printf("Number of Selections = %d\n", selections);

    return 0;
}
