#include <stdio.h>

int factorial(int n)
{
    int fact = 1;

    for (int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main()
{
    int n = 8;
    int r = 3;

    int combinations = factorial(n) /
                       (factorial(r) * factorial(n - r));

    printf("Total Servers = %d\n", n);
    printf("Servers Selected = %d\n", r);
    printf("Number of Combinations = %d\n", combinations);

    return 0;
}
