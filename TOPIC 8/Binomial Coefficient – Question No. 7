#include <stdio.h>

int factorial(int n)
{
    int fact = 1;

    for (int i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main()
{
    int n = 10;
    int r = 3;

    int teams = factorial(n) /
                (factorial(r) * factorial(n - r));

    printf("Total Developers = %d\n", n);
    printf("Developers Required = %d\n", r);
    printf("Number of Teams = %d\n", teams);

    return 0;
}
