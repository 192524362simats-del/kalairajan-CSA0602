#include <stdio.h>

int factorial(int n) {
    int fact = 1;

    for (int i = 1; i <= n; i++) {
        fact = fact * i;
    }

    return fact;
}

int main() {
    int n = 5;
    int r = 2;

    int result = factorial(n) / (factorial(r) * factorial(n - r));

    printf("n = %d\n", n);
    printf("r = %d\n", r);
    printf("C(%d,%d) = %d\n", n, r, result);

    return 0;
}
