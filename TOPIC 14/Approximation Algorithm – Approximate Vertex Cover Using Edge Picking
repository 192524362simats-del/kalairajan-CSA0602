def approximate_vertex_cover_edge_picking(edges):
    # Create a copy of edges to track uncovered edges
    uncovered_edges = edges[:]
    vertex_cover = set()
    
    while uncovered_edges:
        # Pick the first uncovered edge
        u, v = uncovered_edges[0]
        
        # Add both endpoints to vertex cover
        vertex_cover.add(u)
        vertex_cover.add(v)
        
        # Remove all edges incident to u or v
        uncovered_edges = [e for e in uncovered_edges 
                          if e[0] != u and e[1] != u 
                          and e[0] != v and e[1] != v]
    
    return sorted(vertex_cover)

# Input
n = 6
edges = [(0,1), (0,2), (1,3), (2,4), (4,5)]

vertex_cover = approximate_vertex_cover_edge_picking(edges)

print("Approximate Vertex Cover:")
print("{" + ",".join(map(str, vertex_cover)) + "}")
print(f"\nCover Size = {len(vertex_cover)}")
