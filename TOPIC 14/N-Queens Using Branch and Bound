def solve_n_queens_branch_bound(n):
    # Arrays to track occupied columns and diagonals
    cols = [False] * n
    diag1 = [False] * (2 * n - 1)  # Main diagonals (row - col + n - 1)
    diag2 = [False] * (2 * n - 1)  # Anti-diagonals (row + col)
    
    board = [[0] * n for _ in range(n)]
    
    def solve(row):
        if row == n:
            return True
        
        for col in range(n):
            # Check if safe using branch and bound
            if not cols[col] and not diag1[row - col + n - 1] and not diag2[row + col]:
                # Place queen
                board[row][col] = 1
                cols[col] = True
                diag1[row - col + n - 1] = True
                diag2[row + col] = True
                
                if solve(row + 1):
                    return True
                
                # Backtrack
                board[row][col] = 0
                cols[col] = False
                diag1[row - col + n - 1] = False
                diag2[row + col] = False
        
        return False
    
    solve(0)
    return board

def print_board(board):
    for row in board:
        print(' '.join('Q' if cell == 1 else '.' for cell in row))

n = 8
board = solve_n_queens_branch_bound(n)

print("One Valid Solution:")
print_board(board)
