def is_safe(vertex, color, colors, graph, n):
    for i in range(n):
        if graph[vertex][i] == 1 and colors[i] == color:
            return False
    return True

def graph_coloring(graph, m, vertex, colors, n):
    if vertex == n:
        return True
    
    for color in range(1, m + 1):
        if is_safe(vertex, color, colors, graph, n):
            colors[vertex] = color
            if graph_coloring(graph, m, vertex + 1, colors, n):
                return True
            colors[vertex] = 0
    
    return False

def min_colors(graph):
    n = len(graph)
    
    # Try from 1 color to n colors
    for m in range(1, n + 1):
        colors = [0] * n
        if graph_coloring(graph, m, 0, colors, n):
            return m
    
    return n

# Build complete graph K4
n = 4
edges = [(0,1), (0,2), (0,3), (1,2), (1,3), (2,3)]

# Create adjacency matrix
graph = [[0] * n for _ in range(n)]
for u, v in edges:
    graph[u][v] = 1
    graph[v][u] = 1

chromatic_number = min_colors(graph)
print(f"Minimum Colors Required = {chromatic_number}")
