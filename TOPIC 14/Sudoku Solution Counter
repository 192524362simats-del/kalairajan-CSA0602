def is_safe(grid, row, col, num):
    # Check row
    for j in range(9):
        if grid[row][j] == num:
            return False
    
    # Check column
    for i in range(9):
        if grid[i][col] == num:
            return False
    
    # Check 3x3 box
    start_row = (row // 3) * 3
    start_col = (col // 3) * 3
    for i in range(start_row, start_row + 3):
        for j in range(start_col, start_col + 3):
            if grid[i][j] == num:
                return False
    
    return True

def count_sudoku_solutions(grid):
    # Make a copy to avoid modifying original
    grid_copy = [row[:] for row in grid]
    solution_count = 0
    
    def solve(grid):
        nonlocal solution_count
        
        # Find empty cell
        for i in range(9):
            for j in range(9):
                if grid[i][j] == 0:
                    # Try numbers 1-9
                    for num in range(1, 10):
                        if is_safe(grid, i, j, num):
                            grid[i][j] = num
                            solve(grid)
                            grid[i][j] = 0
                    return  # Backtrack if no number works
        
        # No empty cells found → valid solution
        solution_count += 1
    
    solve(grid_copy)
    return solution_count

