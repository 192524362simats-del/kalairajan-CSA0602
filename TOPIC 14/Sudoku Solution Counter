# Empty grid has many solutions - let's count up to a limit
def count_sudoku_solutions_limit(grid, limit=10):
    grid_copy = [row[:] for row in grid]
    solution_count = 0
    
    def solve(grid):
        nonlocal solution_count
        if solution_count >= limit:
            return
        
        for i in range(9):
            for j in range(9):
                if grid[i][j] == 0:
                    for num in range(1, 10):
                        if is_safe(grid, i, j, num):
                            grid[i][j] = num
                            solve(grid)
                            grid[i][j] = 0
                    return
        
        solution_count += 1
    
    solve(grid_copy)
    return solution_count

