def solve_n_queens_all(n):
    def is_safe(board, row, col):
        # Check column
        for i in range(row):
            if board[i][col] == 1:
                return False
        
        # Check upper left diagonal
        i, j = row - 1, col - 1
        while i >= 0 and j >= 0:
            if board[i][j] == 1:
                return False
            i -= 1
            j -= 1
        
        # Check upper right diagonal
        i, j = row - 1, col + 1
        while i >= 0 and j < n:
            if board[i][j] == 1:
                return False
            i -= 1
            j += 1
        
        return True
    
    def solve(board, row, solutions):
        if row == n:
            # Add a copy of the board to solutions
            solutions.append([row[:] for row in board])
            return
        
        for col in range(n):
            if is_safe(board, row, col):
                board[row][col] = 1
                solve(board, row + 1, solutions)
                board[row][col] = 0
    
    board = [[0] * n for _ in range(n)]
    solutions = []
    solve(board, 0, solutions)
    return solutions

def print_board(board):
    for row in board:
        print(' '.join(map(str, row)))

n = 4
solutions = solve_n_queens_all(n)

print(f"Total Solutions = {len(solutions)}\n")

for i, board in enumerate(solutions, 1):
    print(f"Solution {i}:")
    print_board(board)
    print()
