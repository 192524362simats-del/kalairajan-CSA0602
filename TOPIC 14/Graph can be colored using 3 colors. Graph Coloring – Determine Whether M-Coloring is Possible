def is_safe(vertex, color, colors, graph, m):
    for i in range(len(graph)):
        if graph[vertex][i] == 1 and colors[i] == color:
            return False
    return True

def graph_coloring(graph, m, vertex, colors, n):
    if vertex == n:
        return True
    
    for color in range(1, m + 1):
        if is_safe(vertex, color, colors, graph, m):
            colors[vertex] = color
            if graph_coloring(graph, m, vertex + 1, colors, n):
                return True
            colors[vertex] = 0
    
    return False

def is_colorable(graph, m):
    n = len(graph)
    colors = [0] * n
    return graph_coloring(graph, m, 0, colors, n)

# Build graph from edges
n = 5
m = 3
edges = [(0,1), (0,2), (1,2), (1,3), (2,4)]

# Create adjacency matrix
graph = [[0] * n for _ in range(n)]
for u, v in edges:
    graph[u][v] = 1
    graph[v][u] = 1

if is_colorable(graph, m):
    print(f"Graph can be colored using {m} colors.")
else:
    print(f"Graph cannot be colored using {m} colors.")
