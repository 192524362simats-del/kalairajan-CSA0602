def best_fit_bin_packing(items, bin_capacity):
    # Initialize bins with their remaining capacity
    bins = []  # Each element is a list of [remaining_capacity, [items_in_bin]]
    
    for item in items:
        best_fit_index = -1
        best_remaining = float('inf')
        
        # Find the bin with least remaining space that can fit the item
        for i, (remaining, bin_items) in enumerate(bins):
            if remaining >= item:
                if remaining - item < best_remaining:
                    best_remaining = remaining - item
                    best_fit_index = i
        
        # If found a suitable bin, place item there
        if best_fit_index != -1:
            bins[best_fit_index][0] -= item
            bins[best_fit_index][1].append(item)
        else:
            # Create new bin
            bins.append([bin_capacity - item, [item]])
    
    return bins

def print_bins(bins):
    for i, (remaining, bin_items) in enumerate(bins, 1):
        print(f"Bin {i}: {' '.join(map(str, bin_items))}")

# Input
bin_capacity = 10
items = [2, 5, 4, 7, 1, 3, 8]

bins = best_fit_bin_packing(items, bin_capacity)

print("Best Fit Bin Packing:")
print_bins(bins)
print(f"\nTotal Bins Used = {len(bins)}")
