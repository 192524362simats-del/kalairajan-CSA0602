def solve_n_queens(n):
    def is_safe(board, row, col):
        # Check column
        for i in range(row):
            if board[i][col] == 1:
                return False
        
        # Check upper left diagonal
        i, j = row - 1, col - 1
        while i >= 0 and j >= 0:
            if board[i][j] == 1:
                return False
            i -= 1
            j -= 1
        
        # Check upper right diagonal
        i, j = row - 1, col + 1
        while i >= 0 and j < n:
            if board[i][j] == 1:
                return False
            i -= 1
            j += 1
        
        return True
    
    def solve(board, row):
        if row == n:
            return True
        
        for col in range(n):
            if is_safe(board, row, col):
                board[row][col] = 1
                if solve(board, row + 1):
                    return True
                board[row][col] = 0
        
        return False
    
    board = [[0] * n for _ in range(n)]
    solve(board, 0)
    return board

def print_board(board):
    for row in board:
        print(' '.join(map(str, row)))

n = 4
board = solve_n_queens(n)
print("One Valid Solution:")
print_board(board)
