def count_n_queens(n):
    def is_safe(row, col):
        # Check column
        for i in range(row):
            if cols[i] == col:
                return False
        
        # Check diagonals
        for i in range(row):
            if abs(cols[i] - col) == abs(i - row):
                return False
        
        return True
    
    def solve(row):
        nonlocal count
        if row == n:
            count += 1
            return
        
        for col in range(n):
            if is_safe(row, col):
                cols[row] = col
                solve(row + 1)
                cols[row] = -1
    
    cols = [-1] * n
    count = 0
    solve(0)
    return count

n = 8
total = count_n_queens(n)
print(f"Total Number of Solutions = {total}")
