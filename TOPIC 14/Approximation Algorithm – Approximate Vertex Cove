def greedy_vertex_cover(edges, n):
    # Create adjacency list
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    
    # Copy edges to process
    remaining_edges = edges[:]
    vertex_cover = set()
    
    while remaining_edges:
        # Pick an edge (u, v)
        u, v = remaining_edges[0]
        
        # Add both endpoints to vertex cover
        vertex_cover.add(u)
        vertex_cover.add(v)
        
        # Remove all edges incident to u or v
        remaining_edges = [e for e in remaining_edges if e[0] != u and e[1] != u and e[0] != v and e[1] != v]
    
    return sorted(vertex_cover)

def approximate_vertex_cover(edges, n):
    # Alternative: pick vertex with maximum degree
    adj = [[] for _ in range(n)]
    for u, v in edges:
        adj[u].append(v)
        adj[v].append(u)
    
    remaining_edges = edges[:]
    vertex_cover = set()
    
    while remaining_edges:
        # Find vertex with maximum degree
        degree = [0] * n
        for u, v in remaining_edges:
            degree[u] += 1
            degree[v] += 1
        
        max_degree = max(degree)
        if max_degree == 0:
            break
        
        v = degree.index(max_degree)
        vertex_cover.add(v)
        
        # Remove all edges incident to v
        remaining_edges = [e for e in remaining_edges if e[0] != v and e[1] != v]
    
    return sorted(vertex_cover)

n = 5
edges = [(0,1), (0,2), (1,3), (2,4)]

# Using greedy max-degree approach
vertex_cover = approximate_vertex_cover(edges, n)

print("Approximate Vertex Cover:")
print("{" + ",".join(map(str, vertex_cover)) + "}")
print(f"\nCover Size = {len(vertex_cover)}")
