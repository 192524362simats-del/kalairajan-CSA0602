def bubble_sort_with_frames(arr):
    # Make a copy so the original array is not modified
    data = arr.copy()

    # Store all visualization frames
    frames = [data.copy()]

    n = len(data)

    # Bubble Sort
    for i in range(n - 1):
        swapped = False

        # Compare adjacent elements
        for j in range(n - 1 - i):
            if data[j] > data[j + 1]:
                data[j], data[j + 1] = data[j + 1], data[j]
                swapped = True

        # Store the array state after every pass
        frames.append(data.copy())

        # Stop if the array is already sorted
        if not swapped:
            break

    return frames


# Test Case
frames = bubble_sort_with_frames([5, 1, 4, 2, 8])

assert frames[-1] == sorted([5, 1, 4, 2, 8])
assert frames[0] == [5, 1, 4, 2, 8]
assert len(frames) >= 2

print("All test cases passed!")

# Display every frame
print("\nBubble Sort Visualization:")

for i, frame in enumerate(frames):
    if i == 0:
        print("Initial:", frame)
    else:
        print("Pass", i, ":", frame)
