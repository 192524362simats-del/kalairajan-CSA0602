def selection_sort_min_writes(arr):
    # Make a copy so the original data is not modified
    data = arr.copy()
    swaps = 0
    n = len(data)

    # Selection Sort
    for i in range(n - 1):
        min_index = i

        # Find the minimum element in the remaining portion
        for j in range(i + 1, n):
            if data[j] < data[min_index]:
                min_index = j

        # Swap only if the minimum is not already in place
        if min_index != i:
            data[i], data[min_index] = data[min_index], data[i]
            swaps += 1

    return data, swaps


# Test Case 1
res, sw = selection_sort_min_writes(
    [23.5, 19.2, 25.1, 18.8, 21.4]
)

assert res == sorted([23.5, 19.2, 25.1, 18.8, 21.4])
assert sw <= len(res) - 1

# Test Case 2: Already sorted
res2, sw2 = selection_sort_min_writes(
    [1, 2, 3, 4, 5]
)

assert sw2 == 0

print("All test cases passed!")

# Display result
print("Sorted readings:", res)
print("Number of swaps:", sw)
print("Maximum possible swaps:", len(res) - 1)
