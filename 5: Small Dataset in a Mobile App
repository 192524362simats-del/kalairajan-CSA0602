import time


def selection_sort(prices):
    # Make a copy so the original list is not modified
    arr = prices.copy()
    n = len(arr)

    # Selection Sort
    for i in range(n - 1):
        min_index = i

        # Find the minimum price
        for j in range(i + 1, n):
            if arr[j] < arr[min_index]:
                min_index = j

        # Swap if necessary
        if min_index != i:
            arr[i], arr[min_index] = arr[min_index], arr[i]

    return arr


# Test Case 1
assert selection_sort(
    [499, 129, 899, 45, 275, 60, 310, 150]
) == sorted([499, 129, 899, 45, 275, 60, 310, 150])


# Test Case 2: Empty list
assert selection_sort([]) == []


# Test Case 3: Single item
assert selection_sort([7]) == [7]


print("All test cases passed!")


# Timing the selection sort
prices = [499, 129, 899, 45, 275, 60, 310, 150]

start_time = time.perf_counter()

sorted_prices = selection_sort(prices)

end_time = time.perf_counter()

execution_time = (end_time - start_time) * 1_000_000

print("Original prices:", prices)
print("Sorted prices:", sorted_prices)
print("Execution time: {:.2f} microseconds".format(execution_time))
