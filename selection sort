#include <stdio.h>

int main() {
    int a[] = {14, 52, 31, 52, 9, 27};
    int n = sizeof(a) / sizeof(a[0]);

    int i, j, min, temp;
    int comparisons = 0;
    int swaps = 0;

    printf("OriginalArray\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");

    // Selection Sort
    for(i = 0; i < n - 1; i++) {

        min = i;

        for(j = i + 1; j < n; j++) {
            comparisons++;

            if(a[j] < a[min])
                min = j;
        }

        if(min != i) {
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
            swaps++;
        }

        printf("Pass%d:", i + 1);
        for(j = 0; j < n; j++)
            printf("%d ", a[j]);
        printf("\n");
    }

    printf("SortedArray\n");
    for(i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");

    printf("Comparisons=%d\n", comparisons);
    printf("Swaps=%d\n", swaps);

    printf("TimeComplexityBest=O(n^2)\n");
    printf("TimeComplexityAverage=O(n^2)\n");
    printf("TimeComplexityWorst=O(n^2)\n");

    return 0;
}
