def insert_song(playlist, new_song):
    # Add the new song at the end
    playlist.append(new_song)

    # Start from the newly added song
    i = len(playlist) - 1

    # Shift longer songs to the right
    while i > 0 and playlist[i - 1][1] > playlist[i][1]:
        playlist[i], playlist[i - 1] = playlist[i - 1], playlist[i]
        i -= 1

    return playlist


# Test cases
playlist = [
    ('Intro', 120),
    ('Chill Beat', 210),
    ('Long Jam', 340)
]

updated_playlist = insert_song(playlist, ('Quick Track', 180))

print("Updated Playlist:")
for song in updated_playlist:
    print(song)

# Verify sorted order
durations = [s[1] for s in updated_playlist]

assert durations == sorted([120, 210, 340, 180])
assert ('Quick Track', 180) in updated_playlist

print("\nAll test cases passed!")
