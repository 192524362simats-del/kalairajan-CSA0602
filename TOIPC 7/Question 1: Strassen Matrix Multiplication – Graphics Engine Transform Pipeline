#include <stdio.h>
#include <stdlib.h>

#define MAX 128

void addMatrix(int n, int A[MAX][MAX], int B[MAX][MAX], int C[MAX][MAX]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            C[i][j] = A[i][j] + B[i][j];
}

void subtractMatrix(int n, int A[MAX][MAX], int B[MAX][MAX], int C[MAX][MAX]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            C[i][j] = A[i][j] - B[i][j];
}

void standardMultiply(int n, int A[MAX][MAX], int B[MAX][MAX],
                      int C[MAX][MAX]) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            C[i][j] = 0;
            for (int k = 0; k < n; k++)
                C[i][j] += A[i][k] * B[k][j];
        }
    }
}

void strassen(int n, int A[MAX][MAX], int B[MAX][MAX],
              int C[MAX][MAX]) {

    if (n == 1) {
        C[0][0] = A[0][0] * B[0][0];
        return;
    }

    int k = n / 2;

    int A11[MAX][MAX], A12[MAX][MAX];
    int A21[MAX][MAX], A22[MAX][MAX];

    int B11[MAX][MAX], B12[MAX][MAX];
    int B21[MAX][MAX], B22[MAX][MAX];

    int M1[MAX][MAX], M2[MAX][MAX], M3[MAX][MAX];
    int M4[MAX][MAX], M5[MAX][MAX], M6[MAX][MAX], M7[MAX][MAX];

    int T1[MAX][MAX], T2[MAX][MAX];

    for (int i = 0; i < k; i++) {
        for (int j = 0; j < k; j++) {
            A11[i][j] = A[i][j];
            A12[i][j] = A[i][j + k];
            A21[i][j] = A[i + k][j];
            A22[i][j] = A[i + k][j + k];

            B11[i][j] = B[i][j];
            B12[i][j] = B[i][j + k];
            B21[i][j] = B[i + k][j];
            B22[i][j] = B[i + k][j + k];
        }
    }

    // M1 = (A11 + A22)(B11 + B22)
    addMatrix(k, A11, A22, T1);
    addMatrix(k, B11, B22, T2);
    strassen(k, T1, T2, M1);

    // M2 = (A21 + A22)B11
    addMatrix(k, A21, A22, T1);
    strassen(k, T1, B11, M2);

    // M3 = A11(B12 - B22)
    subtractMatrix(k, B12, B22, T1);
    strassen(k, A11, T1, M3);

    // M4 = A22(B21 - B11)
    subtractMatrix(k, B21, B11, T1);
    strassen(k, A22, T1, M4);

    // M5 = (A11 + A12)B22
    addMatrix(k, A11, A12, T1);
    strassen(k, T1, B22, M5);

    // M6 = (A21 - A11)(B11 + B12)
    subtractMatrix(k, A21, A11, T1);
    addMatrix(k, B11, B12, T2);
    strassen(k, T1, T2, M6);

    // M7 = (A12 - A22)(B21 + B22)
    subtractMatrix(k, A12, A22, T1);
    addMatrix(k, B21, B22, T2);
    strassen(k, T1, T2, M7);

    // C11 = M1 + M4 - M5 + M7
    // C12 = M3 + M5
    // C21 = M2 + M4
    // C22 = M1 - M2 + M3 + M6

    for (int i = 0; i < k; i++) {
        for (int j = 0; j < k; j++) {

            C[i][j] =
                M1[i][j] + M4[i][j] - M5[i][j] + M7[i][j];

            C[i][j + k] =
                M3[i][j] + M5[i][j];

            C[i + k][j] =
                M2[i][j] + M4[i][j];

            C[i + k][j + k] =
                M1[i][j] - M2[i][j] + M3[i][j] + M6[i][j];
        }
    }
}

int nextPowerOfTwo(int n) {
    int p = 1;

    while (p < n)
        p *= 2;

    return p;
}

void strassenMultiply(int n, int A[MAX][MAX], int B[MAX][MAX],
                      int C[MAX][MAX]) {

    int size = nextPowerOfTwo(n);

    int PA[MAX][MAX] = {0};
    int PB[MAX][MAX] = {0};
    int PC[MAX][MAX] = {0};

    // Copy original matrices into padded matrices
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            PA[i][j] = A[i][j];
            PB[i][j] = B[i][j];
        }
    }

    // Strassen multiplication
    strassen(size, PA, PB, PC);

    // Remove padding
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            C[i][j] = PC[i][j];
        }
    }
}

void printMatrix(int n, int A[MAX][MAX]) {
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++)
            printf("%d ", A[i][j]);
        printf("\n");
    }
}

int compareMatrices(int n, int A[MAX][MAX], int B[MAX][MAX]) {
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            if (A[i][j] != B[i][j])
                return 0;

    return 1;
}

int main() {

    /* Test Case 1 */
    int A1[2][2] = {
        {1, 2},
        {3, 4}
    };

    int B1[2][2] = {
        {5, 6},
        {7, 8}
    };

    int S1[MAX][MAX] = {0};
    int N1[MAX][MAX] = {0};

    strassenMultiply(2, A1, B1, S1);
    standardMultiply(2, A1, B1, N1);

    printf("Test Case 1\n");
    printf("Strassen Result:\n");
    printMatrix(2, S1);

    printf("Standard Multiplication Result:\n");
    printMatrix(2, N1);

    if (compareMatrices(2, S1, N1))
        printf("Test Case 1: Passed\n\n");
    else
        printf("Test Case 1: Failed\n\n");


    /* Test Case 2 */
    int A2[3][3] = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };

    int B2[3][3] = {
        {9, 8, 7},
        {6, 5, 4},
        {3, 2, 1}
    };

    int S2[MAX][MAX] = {0};
    int N2[MAX][MAX] = {0};

    strassenMultiply(3, A2, B2, S2);
    standardMultiply(3, B2, A2, N2);

    printf("Test Case 2\n");
    printf("Strassen Result:\n");
    printMatrix(3, S2);

    printf("Standard Multiplication Result:\n");
    printMatrix(3, N2);

    if (compareMatrices(3, S2, N2))
        printf("Test Case 2: Passed\n\n");
    else
        printf("Test Case 2: Failed\n\n");

    printf("All test cases passed!\n");

    return 0;
}
