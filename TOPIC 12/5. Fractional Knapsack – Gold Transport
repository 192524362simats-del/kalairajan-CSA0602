//Fractional Knapsack – Gold Transport
#include<stdio.h>
int main()
{
    int weights[]={5,10,15};
    int profits[]={30,40,45};
    int n=3,capacity=20,i,j,tempW,tempP;
    float ratio[3],tempR,totalProfit=0;
    for(i=0;i<n;i++)
        ratio[i]=(float)profits[i]/weights[i];
    for(i=0;i<n-1;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(ratio[i]<ratio[j])
            {
                tempR=ratio[i];
                ratio[i]=ratio[j];
                ratio[j]=tempR;
                tempW=weights[i];
                weights[i]=weights[j];
                weights[j]=tempW;
                tempP=profits[i];
                profits[i]=profits[j];
                profits[j]=tempP;
            }
        }
    }
    for(i=0;i<n;i++)
    {
        if(capacity>=weights[i])
        {
            capacity-=weights[i];
            totalProfit+=profits[i];
        }
        else
        {
            totalProfit+=ratio[i]*capacity;
            capacity=0;
            break;
        }
    }
    printf("Maximum profit = %.0f\n",totalProfit);
    return 0;
}
