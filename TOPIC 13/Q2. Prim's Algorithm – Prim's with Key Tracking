import heapq

def prim_with_keys(n, start, edges):
    # Build adjacency list
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    visited = [False] * n
    key = [float('inf')] * n
    parent = [-1] * n
    key[start] = 0
    
    min_heap = [(0, start)]
    mst_edges = []
    total_weight = 0
    
    print(f"Initial key[]: {[str(int(k)) if k != float('inf') else 'inf' for k in key]}")
    step = 1
    
    while min_heap:
        weight, u = heapq.heappop(min_heap)
        
        if visited[u]:
            continue
        
        visited[u] = True
        
        if parent[u] != -1:
            mst_edges.append((parent[u], u, weight))
            total_weight += weight
        
        for v, w in graph[u]:
            if not visited[v] and w < key[v]:
                key[v] = w
                parent[v] = u
                heapq.heappush(min_heap, (w, v))
        
        # Show key array after each step
        if step <= n:
            key_display = [str(int(k)) if k != float('inf') else 'inf' for k in key]
            print(f"After picking {u}: key[]={key_display}")
            step += 1
    
    return mst_edges, total_weight

n = 5
start = 2
edges = [(0,1,2), (0,3,6), (1,2,3), (1,3,8), (1,4,5), (2,4,7), (3,4,9)]

mst, total_weight = prim_with_keys(n, start, edges)

print(f"MST edges: {mst}  weight: {total_weight}")
