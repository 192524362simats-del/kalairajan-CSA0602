import heapq

def dijkstra_path(n, source, dest, edges):
    # Build adjacency list
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))  # Undirected graph
    
    dist = [float('inf')] * n
    parent = [-1] * n
    dist[source] = 0
    
    pq = [(0, source)]
    
    while pq:
        curr_dist, u = heapq.heappop(pq)
        
        if curr_dist > dist[u]:
            continue
        
        if u == dest:
            break
        
        for v, w in graph[u]:
            new_dist = curr_dist + w
            if new_dist < dist[v]:
                dist[v] = new_dist
                parent[v] = u
                heapq.heappush(pq, (new_dist, v))
    
    # Reconstruct path
    path = []
    curr = dest
    while curr != -1:
        path.append(curr)
        curr = parent[curr]
    path = path[::-1]
    
    return dist[dest], path

n = 6
source = 0
dest = 5
edges = [(0,1,7), (0,2,9), (0,5,14), (1,2,10), (1,3,15), 
         (2,3,11), (2,5,2), (3,4,6), (4,5,9)]

distance, path = dijkstra_path(n, source, dest, edges)

print(f"Shortest distance from {source} to {dest}: {distance}")
print(f"Path: {' → '.join(map(str, path))}")
