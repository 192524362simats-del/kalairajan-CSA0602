class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True
    
    def get_components(self, n):
        comps = {}
        for i in range(n):
            root = self.find(i)
            if root not in comps:
                comps[root] = []
            comps[root].append(i)
        return comps

def boruvka_union_find(n, edges):
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    phase = 1
    
    while len(mst_edges) < n - 1:
        cheapest = {}
        
        # Find cheapest edge for each component
        for u, v, w in edges:
            root_u = dsu.find(u)
            root_v = dsu.find(v)
            
            if root_u == root_v:
                continue
            
            if root_u not in cheapest or w < cheapest[root_u][2]:
                cheapest[root_u] = (u, v, w)
            if root_v not in cheapest or w < cheapest[root_v][2]:
                cheapest[root_v] = (u, v, w)
        
        # Display cheapest per component
        comps = dsu.get_components(n)
        print(f"Phase {phase} cheapest per component:")
        for root, vertices in comps.items():
            if root in cheapest:
                edge = cheapest[root]
                print(f"  {vertices}→{edge}")
        
        # Add edges
        phase_edges = []
        for u, v, w in cheapest.values():
            if dsu.union(u, v):
                phase_edges.append((u, v, w))
                mst_edges.append((u, v, w))
                total_weight += w
        
        print(f"Edges added: {sorted(phase_edges)}")
        
        # Show union-find structure
        comps_after = dsu.get_components(n)
        comp_list = [sorted(vertices) for vertices in comps_after.values()]
        print(f"After phase {phase}: {len(comp_list)} component(s): {comp_list}")
        print()
        
        if len(phase_edges) == 0:
            break
        
        phase += 1
    
    return mst_edges, total_weight

n = 6
edges = [(0,1,4), (0,2,3), (1,2,1), (1,3,2), (2,3,4), (3,4,2), (4,5,6), (3,5,5), (0,5,9)]

mst, total_weight = boruvka_union_find(n, edges)

print(f"MST edges: {sorted(mst)}")
print(f"MST weight: {total_weight}")
