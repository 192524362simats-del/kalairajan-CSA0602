import heapq

class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def prim_mst(n, start, edges):
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    visited = [False] * n
    min_heap = [(0, start, -1)]
    mst_edges = []
    total_weight = 0
    
    while min_heap and len(mst_edges) < n - 1:
        weight, u, parent = heapq.heappop(min_heap)
        if visited[u]:
            continue
        visited[u] = True
        if parent != -1:
            mst_edges.append((parent, u, weight))
            total_weight += weight
        for v, w in graph[u]:
            if not visited[v]:
                heapq.heappush(min_heap, (w, v, u))
    
    return sorted(mst_edges), total_weight

def kruskal_mst(n, edges):

    edges.sort(key=lambda x: x[2])
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    
    for u, v, w in edges:
        if dsu.union(u, v):
            mst_edges.append((u, v, w))
            total_weight += w
    
    return sorted(mst_edges), total_weight

n = 6
start = 0
edges = [(0,1,4), (0,2,3), (1,2,1), (1,3,2), (2,3,4), (3,4,2), (4,5,6), (3,5,5)]

prim_edges, prim_weight = prim_mst(n, start, edges)
kruskal_edges, kruskal_weight = kruskal_mst(n, edges.copy())

print(f"Prim's MST:    {prim_edges}  weight: {prim_weight}")
print(f"Kruskal's MST: {kruskal_edges}  weight: {kruskal_weight}")

if prim_edges == kruskal_edges:
    print("Edge sets are identical (same total weight, same edges — different insertion order).")
else:
    print("Edge sets are different.")
