class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def boruvka(n, edges):
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    pass_num = 1
    
    while len(mst_edges) < n - 1:
        # Find cheapest edge for each component
        cheapest = {}
        
        for u, v, w in edges:
            root_u = dsu.find(u)
            root_v = dsu.find(v)
            
            if root_u == root_v:
                continue
            
            # Store cheapest edge for each component
            if root_u not in cheapest or w < cheapest[root_u][2]:
                cheapest[root_u] = (u, v, w)
            if root_v not in cheapest or w < cheapest[root_v][2]:
                cheapest[root_v] = (u, v, w)
        
        # Show cheapest edges for each component
        components = {}
        for i in range(n):
            root = dsu.find(i)
            if root not in components:
                components[root] = []
            components[root].append(i)
        
        print(f"Pass {pass_num} cheapest edges:")
        for root, vertices in components.items():
            if root in cheapest:
                print(f"  Component {vertices}: cheapest = {cheapest[root]}")
        
        # Add cheapest edges to MST
        merged = 0
        for u, v, w in cheapest.values():
            if dsu.union(u, v):
                mst_edges.append((u, v, w))
                total_weight += w
                merged += 1
        
        if merged == 0:
            break
        
        pass_num += 1
    
    return mst_edges, total_weight

n = 4
edges = [(0,1,10), (0,2,6), (0,3,5), (1,3,15), (2,3,4)]

mst, total_weight = boruvka(n, edges)

print(f"MST edges: {mst}  weight: {total_weight}")
