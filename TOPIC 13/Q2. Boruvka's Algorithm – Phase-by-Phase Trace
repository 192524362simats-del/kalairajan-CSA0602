class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def boruvka_phases(n, edges):
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    phase = 1
    
    while len(mst_edges) < n - 1:
        cheapest = {}
        
        for u, v, w in edges:
            root_u = dsu.find(u)
            root_v = dsu.find(v)
            
            if root_u == root_v:
                continue
            
            if root_u not in cheapest or w < cheapest[root_u][2]:
                cheapest[root_u] = (u, v, w)
            if root_v not in cheapest or w < cheapest[root_v][2]:
                cheapest[root_v] = (u, v, w)
        
        # Collect edges added in this phase
        phase_edges = []
        for u, v, w in cheapest.values():
            if dsu.union(u, v):
                phase_edges.append((u, v, w))
                mst_edges.append((u, v, w))
                total_weight += w
        
        if phase_edges:
            print(f"Phase {phase} edges added: {sorted(phase_edges)}")
            phase += 1
        
        if len(phase_edges) == 0:
            break
    
    if len(mst_edges) == n - 1:
        print(f"All vertices merged -> done in {phase-1} phase{'s' if phase-1 > 1 else '!'}")
    else:
        print(f"Done in {phase-1} phases")
    
    return mst_edges, total_weight

n = 5
edges = [(0,1,2), (0,3,6), (1,2,3), (1,3,8), (1,4,5), (2,4,7), (3,4,9)]

mst, total_weight = boruvka_phases(n, edges)

print(f"MST: {sorted(mst)}  weight: {total_weight}")
