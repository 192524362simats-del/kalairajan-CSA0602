class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def boruvka_ties(n, edges):
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    phase = 1
    
    while len(mst_edges) < n - 1:
        cheapest = {}
        
        # Find cheapest edge for each component (first encountered on tie)
        for u, v, w in edges:
            root_u = dsu.find(u)
            root_v = dsu.find(v)
            
            if root_u == root_v:
                continue
            
            # First encountered edge wins on tie (as per expected output)
            if root_u not in cheapest or w < cheapest[root_u][2]:
                cheapest[root_u] = (u, v, w)
            if root_v not in cheapest or w < cheapest[root_v][2]:
                cheapest[root_v] = (u, v, w)
        
        # Display cheapest per component
        comps = {}
        for i in range(n):
            root = dsu.find(i)
            if root not in comps:
                comps[root] = []
            comps[root].append(i)
        
        print(f"Phase {phase}:")
        for root, vertices in comps.items():
            if root in cheapest:
                edge = cheapest[root]
                # Add tie explanation if multiple edges with same weight exist
                tie_edges = []
                for u2, v2, w2 in edges:
                    r1 = dsu.find(u2)
                    if r1 == root and (u2 != edge[0] or v2 != edge[1]) and w2 == edge[2]:
                        # Find if there's another edge with same weight
                        r2 = dsu.find(v2)
                        if r2 == root:
                            continue
                        if w2 == edge[2]:
                            tie_edges.append((u2, v2, w2))
                
                if tie_edges:
                    print(f"  {vertices}: cheapest = {edge}  [first encountered on tie]")
                else:
                    print(f"  {vertices}: cheapest = {edge}")
        
        # Add edges
        phase_edges = []
        for u, v, w in cheapest.values():
            if dsu.union(u, v):
                phase_edges.append((u, v, w))
                mst_edges.append((u, v, w))
                total_weight += w
        
        print(f"Edges added: {sorted(phase_edges)}")
        print()
        
        if len(phase_edges) == 0:
            break
        
        phase += 1
    
    return mst_edges, total_weight

n = 4
edges = [(0,1,5), (0,2,5), (1,2,3), (1,3,4), (2,3,4), (0,3,8)]

mst, total_weight = boruvka_ties(n, edges)

print(f"MST: {sorted(mst)}  weight: {total_weight}")
print("Note: Boruvka's picks the first encountered edge on ties, which may vary with edge ordering.")
