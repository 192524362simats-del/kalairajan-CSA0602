import heapq
import time

class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def boruvka(n, edges):
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    phases = 0
    
    while len(mst_edges) < n - 1:
        cheapest = {}
        
        for u, v, w in edges:
            root_u = dsu.find(u)
            root_v = dsu.find(v)
            
            if root_u == root_v:
                continue
            
            if root_u not in cheapest or w < cheapest[root_u][2]:
                cheapest[root_u] = (u, v, w)
            if root_v not in cheapest or w < cheapest[root_v][2]:
                cheapest[root_v] = (u, v, w)
        
        phase_edges = []
        for u, v, w in cheapest.values():
            if dsu.union(u, v):
                phase_edges.append((u, v, w))
                mst_edges.append((u, v, w))
                total_weight += w
        
        phases += 1
        if len(phase_edges) == 0:
            break
    
    return mst_edges, total_weight, phases

def kruskal(n, edges):
    sorted_edges = sorted(edges, key=lambda x: x[2])
    dsu = DSU(n)
    mst_edges = []
    total_weight = 0
    selections = 0
    
    for u, v, w in sorted_edges:
        if dsu.union(u, v):
            mst_edges.append((u, v, w))
            total_weight += w
            selections += 1
    
    return mst_edges, total_weight, selections

def prim(n, edges):
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    visited = [False] * n
    min_heap = [(0, 0, -1)]
    mst_edges = []
    total_weight = 0
    additions = 0
    
    while min_heap and len(mst_edges) < n - 1:
        weight, u, parent = heapq.heappop(min_heap)
        
        if visited[u]:
            continue
        
        visited[u] = True
        if parent != -1:
            mst_edges.append((parent, u, weight))
            total_weight += weight
            additions += 1
        
        for v, w in graph[u]:
            if not visited[v]:
                heapq.heappush(min_heap, (w, v, u))
    
    return mst_edges, total_weight, additions

n = 6
edges = [(0,1,6), (0,2,1), (0,3,5), (1,2,5), (1,4,3), 
         (2,3,5), (2,4,6), (2,5,4), (3,5,2), (4,5,6)]

# Boruvka's
boruvka_edges, boruvka_weight, phases = boruvka(n, edges.copy())

# Kruskal's
kruskal_edges, kruskal_weight, selections = kruskal(n, edges.copy())

# Prim's
prim_edges, prim_weight, additions = prim(n, edges.copy())

# Sort for comparison
boruvka_edges_sorted = sorted(boruvka_edges)
kruskal_edges_sorted = sorted(kruskal_edges)
prim_edges_sorted = sorted(prim_edges)

print(f"MST edges (all 3 algorithms agree):")
print(f"  {kruskal_edges_sorted}  weight: {boruvka_weight}")
print()
print(f"Boruvka's:  {phases} phases")
print(f"Kruskal's:  {selections} edge selections (sorted pass)")
print(f"Prim's:     {additions} vertex additions")
print()
print(f"Boruvka's fewest 'rounds' due to parallel component merging.")
print(f"For dense graphs (m >> n), Prim's with a binary heap is typically fastest.")
