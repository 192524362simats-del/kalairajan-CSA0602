import heapq

def dijkstra_path(n, source, dest, edges):
    # Build adjacency list for directed graph
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
    
    # Initialize distances and parent
    dist = [float('inf')] * n
    parent = [-1] * n
    dist[source] = 0
    
    # Priority queue
    pq = [(0, source)]
    
    while pq:
        curr_dist, u = heapq.heappop(pq)
        
        if curr_dist > dist[u]:
            continue
        
        if u == dest:
            break
        
        for v, w in graph[u]:
            new_dist = curr_dist + w
            if new_dist < dist[v]:
                dist[v] = new_dist
                parent[v] = u
                heapq.heappush(pq, (new_dist, v))
    
    # Build path
    path = []
    curr = dest
    while curr != -1:
        path.append(curr)
        curr = parent[curr]
    path = path[::-1]
    
    return dist[dest], path

n = 5
source = 0
dest = 4
edges = [(0,1,10), (0,2,3), (1,3,2), (2,1,4), (2,3,8), (2,4,2), (3,4,5)]

distance, path = dijkstra_path(n, source, dest, edges)

print(f"Shortest distance: {distance}")
print(f"Path: {' → '.join(map(str, path))}")
