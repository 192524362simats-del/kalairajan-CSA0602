import heapq

def dijkstra_reachability(n, source, dest, edges):
    # Build adjacency list for undirected graph
    graph = [[] for _ in range(n)]
    for u, v, w in edges:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    dist = [float('inf')] * n
    parent = [-1] * n
    dist[source] = 0
    
    pq = [(0, source)]
    
    while pq:
        curr_dist, u = heapq.heappop(pq)
        
        if curr_dist > dist[u]:
            continue
        
        for v, w in graph[u]:
            new_dist = curr_dist + w
            if new_dist < dist[v]:
                dist[v] = new_dist
                parent[v] = u
                heapq.heappush(pq, (new_dist, v))
    
    # Check reachability
    if dist[dest] == float('inf'):
        return False, None, None
    
    # Reconstruct path
    path = []
    curr = dest
    while curr != -1:
        path.append(curr)
        curr = parent[curr]
    path = path[::-1]
    
    return True, dist[dest], path

n = 5
source = 0
dest = 3
edges = [(0,1,5), (1,2,3), (2,4,1), (3,4,2), (0,4,10)]

reachable, distance, path = dijkstra_reachability(n, source, dest, edges)

if reachable:
    print(f"Node {dest} is reachable.")
    print(f"Shortest distance from {source} to {dest}: {distance}")
    print(f"Path: {' → '.join(map(str, path))}")
else:
    print(f"Node {dest} is not reachable from {source}")
