class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def kruskal_tie_break(n, edges):
    # Sort by weight, then by source vertex for tie-breaking
    edges.sort(key=lambda x: (x[2], x[0]))
    dsu = DSU(n)
    mst = []
    total_weight = 0
    
    for u, v, w in edges:
        if dsu.union(u, v):
            mst.append((u, v, w))
            total_weight += w
    
    return mst, total_weight

n = 5
edges = [(0,1,2), (0,3,6), (1,2,3), (1,3,8), (1,4,5), (2,4,7), (3,4,9)]

mst, total_weight = kruskal_tie_break(n, edges)

print(f"Edges in MST: {mst}")
print(f"Total weight of MST: {total_weight}")
