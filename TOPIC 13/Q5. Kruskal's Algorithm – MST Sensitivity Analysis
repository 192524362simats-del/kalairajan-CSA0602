class DSU:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n
    
    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]
    
    def union(self, x, y):
        px, py = self.find(x), self.find(y)
        if px == py:
            return False
        if self.rank[px] < self.rank[py]:
            self.parent[px] = py
        elif self.rank[px] > self.rank[py]:
            self.parent[py] = px
        else:
            self.parent[py] = px
            self.rank[px] += 1
        return True

def kruskal_mst(n, edges):
    sorted_edges = sorted(edges, key=lambda x: x[2])
    dsu = DSU(n)
    mst = []
    non_mst = []
    
    for u, v, w in sorted_edges:
        if dsu.union(u, v):
            mst.append((u, v, w))
        else:
            non_mst.append((u, v, w))
    
    return mst, non_mst

def find_cycle_edges(mst, new_edge):
    # Build adjacency list from MST
    graph = [[] for _ in range(len(mst) + 1)]
    n = len(graph)
    
    for u, v, w in mst:
        graph[u].append((v, w))
        graph[v].append((u, w))
    
    # Find path between u and v in MST
    u, v, w_new = new_edge
    parent = [-1] * n
    parent_weight = [-1] * n
    
    def dfs(node, par, par_w):
        parent[node] = par
        parent_weight[node] = par_w
        for neighbor, weight in graph[node]:
            if neighbor != par:
                dfs(neighbor, node, weight)
    
    dfs(u, -1, -1)
    
    # Trace path from v to u
    path_edges = []
    curr = v
    while curr != u:
        path_edges.append((parent[curr], curr, parent_weight[curr]))
        curr = parent[curr]
    
    # Find max weight edge in path
    max_edge = max(path_edges, key=lambda x: x[2])
    return max_edge

n = 5
edges = [(0,1,1), (0,2,5), (1,2,3), (1,3,4), (2,3,2), (2,4,6), (3,4,7), (0,4,9)]

mst, non_mst = kruskal_mst(n, edges)
mst_weight = sum(w for _, _, w in mst)

print(f"MST edges: {mst}  weight: {mst_weight}")
print(f"Non-MST edges: {non_mst}")

# Find best swap
best_swap = None
best_new_weight = float('inf')

for edge in non_mst:
    u, v, w_new = edge
    # Find max weight edge in cycle
    max_edge = find_cycle_edges(mst, edge)
    new_weight = mst_weight - max_edge[2] + w_new
    
    if new_weight < best_new_weight:
        best_new_weight = new_weight
        best_swap = (edge, max_edge)

add_edge, remove_edge = best_swap
print(f"Best swap: add {add_edge}, remove {remove_edge}")
print(f"New MST weight: {best_new_weight}")
