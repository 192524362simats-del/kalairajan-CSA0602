def reorder_shelf(books):
    # Make a copy so the original shelf is not modified
    shelf = books.copy()
    moves = 0
    n = len(shelf)

    # Selection Sort
    for i in range(n - 1):
        min_index = i

        # Find the book with the smallest ID
        for j in range(i + 1, n):
            if shelf[j] < shelf[min_index]:
                min_index = j

        # Perform a physical move only when necessary
        if min_index != i:
            shelf[i], shelf[min_index] = shelf[min_index], shelf[i]
            moves += 1

    return shelf, moves


# Test Case 1
ordered, moves = reorder_shelf(
    [305, 102, 250, 118, 199, 400, 101]
)

assert ordered == sorted(
    [305, 102, 250, 118, 199, 400, 101]
)

assert moves <= len(ordered) - 1


# Test Case 2: Already sorted
ordered2, moves2 = reorder_shelf(
    [100, 200, 300]
)

assert moves2 == 0


print("All test cases passed!")

# Display result
print("Reordered shelf:", ordered)
print("Physical moves:", moves)
print("Maximum possible moves:", len(ordered) - 1)
