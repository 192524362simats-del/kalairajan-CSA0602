def bubble_sort_queue(queue):
    # Make a copy so the original queue is not modified
    vehicles = queue.copy()
    n = len(vehicles)

    # Vehicle priority
    # Higher number = higher priority
    priority = {
        "ambulance": 3,
        "bus": 2,
        "car": 1
    }

    # Bubble Sort
    for i in range(n - 1):
        swapped = False

        for j in range(n - 1 - i):
            # Compare priorities of adjacent vehicles
            if priority[vehicles[j]] < priority[vehicles[j + 1]]:
                vehicles[j], vehicles[j + 1] = (
                    vehicles[j + 1],
                    vehicles[j]
                )
                swapped = True

        # Stop early if no swaps occurred
        if not swapped:
            break

    return vehicles


# Test Case 1
queue = ["car", "car", "bus"]

queue.append("ambulance")

result = bubble_sort_queue(queue)

assert result == [
    "ambulance",
    "bus",
    "car",
    "car"
]


# Test Case 2: Single vehicle
assert bubble_sort_queue(["ambulance"]) == ["ambulance"]


print("All test cases passed!")

# Display final queue
print("Priority Queue:", result)
