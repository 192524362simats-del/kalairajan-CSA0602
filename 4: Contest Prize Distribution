def distribute_prizes(participants):
    # Make a copy so the original list is not modified
    ranking = participants.copy()
    n = len(ranking)

    # Selection Sort in descending order
    for i in range(n - 1):
        max_index = i

        # Find the participant with the highest score
        for j in range(i + 1, n):
            if ranking[j][1] > ranking[max_index][1]:
                max_index = j

        # Swap the highest-scoring participant into position i
        if max_index != i:
            ranking[i], ranking[max_index] = ranking[max_index], ranking[i]

        # Print the participant ranked at this position
        print("Rank", i + 1, ":", ranking[i][0],
              "-", ranking[i][1])

    # Print the final participant
    if n > 0:
        print("Rank", n, ":", ranking[n - 1][0],
              "-", ranking[n - 1][1])

    return ranking


# Test Case
ranking = distribute_prizes([
    ('Asha', 88),
    ('Ravi', 95),
    ('Meera', 79),
    ('Dev', 95)
])

scores_only = [p[1] for p in ranking]

assert scores_only == sorted(scores_only, reverse=True)
assert ranking[0][1] == 95

print("All test cases passed!")
