#include <stdio.h>

int lastOccurrence(int arr[], int n, int key) {
    int low = 0;
    int high = n - 1;
    int result = -1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == key) {
            result = mid;
            low = mid + 1;   // Search for a later occurrence
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    return result;
}

int main() {
    int n, key;

    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    scanf("%d", &key);

    int result = lastOccurrence(arr, n, key);

    if (result != -1) {
        printf("Last occurrence at index %d\n", result);
    }
    else {
        printf("Element not found\n");
    }

    return 0;
}
