#include <stdio.h>

void findSubset(int set[], int n, int target) {
    int totalSubsets = 1 << n;
    int found = 0;

    // Generate all possible subsets
    for (int mask = 0; mask < totalSubsets; mask++) {

        int sum = 0;

        // Calculate sum of current subset
        for (int i = 0; i < n; i++) {
            if (mask & (1 << i)) {
                sum += set[i];
            }
        }

        // Check whether target sum is reached
        if (sum == target) {

            printf("Subset found: [");

            int first = 1;

            for (int i = 0; i < n; i++) {
                if (mask & (1 << i)) {

                    if (!first)
                        printf(", ");

                    printf("%d", set[i]);
                    first = 0;
                }
            }

            printf("]\n");
            printf("Sum: %d\n", target);

            found = 1;
            return;
        }
    }

    if (!found) {
        printf("No subset found with sum %d\n", target);
    }
}

int main() {

    int set[] = {3, 34, 4, 12, 5, 2};
    int n = sizeof(set) / sizeof(set[0]);

    int target = 9;

    findSubset(set, n, target);

    return 0;
}
