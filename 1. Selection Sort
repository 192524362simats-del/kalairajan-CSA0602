def top_k_scores(scores, k):
    # Make a copy so the original list is not modified
    arr = scores.copy()

    n = len(arr)

    # Perform selection sort for only k positions
    for i in range(min(k, n)):
        max_index = i

        # Find the maximum element in the remaining portion
        for j in range(i + 1, n):
            if arr[j] > arr[max_index]:
                max_index = j

        # Swap maximum element with the current position
        arr[i], arr[max_index] = arr[max_index], arr[i]

    # Return only the top k scores
    return arr[:k]


# Test Case 1
assert top_k_scores(
    [72, 88, 65, 90, 77, 95, 60, 83, 91, 68], 5
) == [95, 91, 90, 88, 83]

# Test Case 2: Fewer than k items
assert top_k_scores([5, 3, 1], 5) == [5, 3, 1]

# Test Case 3: Empty input
assert top_k_scores([], 3) == []

print("All test cases passed!")

# Example output
scores = [72, 88, 65, 90, 77, 95, 60, 83, 91, 68]
k = 5

print("Top", k, "scores:", top_k_scores(scores, k))
