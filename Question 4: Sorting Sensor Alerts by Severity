def bubble_sort_plain(arr):
    data = arr.copy()
    n = len(data)
    comparisons = 0

    # Plain Bubble Sort
    for i in range(n - 1):
        for j in range(n - 1 - i):
            comparisons += 1

            if data[j] > data[j + 1]:
                data[j], data[j + 1] = data[j + 1], data[j]

    return data, comparisons


def bubble_sort_optimized(arr):
    data = arr.copy()
    n = len(data)
    comparisons = 0

    # Optimized Bubble Sort
    for i in range(n - 1):
        swapped = False

        for j in range(n - 1 - i):
            comparisons += 1

            if data[j] > data[j + 1]:
                data[j], data[j + 1] = data[j + 1], data[j]
                swapped = True

        # Stop if no swaps occurred
        if not swapped:
            break

    return data, comparisons


# Alert severity data
alerts = [2, 1, 3, 2, 1, 4, 3, 2, 5, 1, 2, 3, 4, 1, 2]


# Run Plain Bubble Sort
r1, c1 = bubble_sort_plain(alerts)

# Run Optimized Bubble Sort
r2, c2 = bubble_sort_optimized(alerts)


# Test cases
assert r1 == r2 == sorted(alerts)
assert c2 <= c1


print("Plain comparisons:", c1,
      "| Optimized comparisons:", c2)

print("Sorted alerts:", r1)

print("All test cases passed!")
