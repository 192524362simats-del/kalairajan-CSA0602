#include <stdio.h>

long long mergeComparisons = 0;
long long quickComparisons = 0;

/* ---------- Merge Sort ---------- */

void merge(int a[], int low, int mid, int high) {
    int i = low;
    int j = mid + 1;
    int k = 0;

    int temp[high - low + 1];

    while (i <= mid && j <= high) {
        mergeComparisons++;

        if (a[i] <= a[j]) {
            temp[k++] = a[i++];
        } else {
            temp[k++] = a[j++];
        }
    }

    while (i <= mid)
        temp[k++] = a[i++];

    while (j <= high)
        temp[k++] = a[j++];

    for (i = low, k = 0; i <= high; i++, k++)
        a[i] = temp[k];
}

void mergeSort(int a[], int low, int high) {
    if (low < high) {
        int mid = (low + high) / 2;

        mergeSort(a, low, mid);
        mergeSort(a, mid + 1, high);

        merge(a, low, mid, high);
    }
}

/* ---------- Quick Sort ---------- */

void swap(int *x, int *y) {
    int temp = *x;
    *x = *y;
    *y = temp;
}

int partition(int a[], int low, int high) {
    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        quickComparisons++;

        if (a[j] <= pivot) {
            i++;
            swap(&a[i], &a[j]);
        }
    }

    swap(&a[i + 1], &a[high]);

    return i + 1;
}

void quickSort(int a[], int low, int high) {
    if (low < high) {
        int pivotIndex = partition(a, low, high);

        quickSort(a, low, pivotIndex - 1);
        quickSort(a, pivotIndex + 1, high);
    }
}

/* ---------- Main Function ---------- */

int main() {
    int n;

    printf("Enter N: ");
    scanf("%d", &n);

    int a[n], mergeArray[n], quickArray[n];

    printf("Enter array elements:\n");

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);

        /* Create identical copies */
        mergeArray[i] = a[i];
        quickArray[i] = a[i];
    }

    /* Apply Merge Sort */
    mergeSort(mergeArray, 0, n - 1);

    /* Apply Quick Sort */
    quickSort(quickArray, 0, n - 1);

    printf("\nSorted Array : ");

    for (int i = 0; i < n; i++) {
        printf("%d", mergeArray[i]);

        if (i < n - 1)
            printf(",");
    }

    printf("\nMerge Comparisons : %lld", mergeComparisons);
    printf("\nQuick Comparisons : %lld", quickComparisons);

    /* Performance analysis */
    if (mergeComparisons < quickComparisons) {
        printf("\nAnalysis : Merge Sort performs better for this input.");
    } else if (quickComparisons < mergeComparisons) {
        printf("\nAnalysis : Quick Sort performs better for this input.");
    } else {
        printf("\nAnalysis : Both algorithms perform equally for this input.");
    }

    printf("\n");

    return 0;
}
