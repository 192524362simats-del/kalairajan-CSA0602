#include <stdio.h>

int maxDepth = 0;

void swap(int *a, int *b) {
    int temp = *a;
    *a = *b;
    *b = temp;
}

int partition(int a[], int low, int high) {
    int pivot = a[high];
    int i = low - 1;

    for (int j = low; j < high; j++) {
        if (a[j] <= pivot) {
            i++;
            swap(&a[i], &a[j]);
        }
    }

    swap(&a[i + 1], &a[high]);

    return i + 1;
}

void quickSort(int a[], int low, int high, int depth) {
    if (low < high) {

        /* Update maximum recursion depth */
        depth++;
        if (depth > maxDepth) {
            maxDepth = depth;
        }

        int pivotIndex = partition(a, low, high);

        quickSort(a, low, pivotIndex - 1, depth);
        quickSort(a, pivotIndex + 1, high, depth);
    }
}

void displayArray(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);

        if (i < n - 1)
            printf(",");
    }
    printf("\n");
}

int main() {
    int n;

    printf("Enter N: ");
    scanf("%d", &n);

    int a[n];

    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }

    maxDepth = 0;

    quickSort(a, 0, n - 1, 0);

    printf("\nSorted Array : ");
    displayArray(a, n);

    printf("Max Depth : %d\n", maxDepth);

    return 0;
}
