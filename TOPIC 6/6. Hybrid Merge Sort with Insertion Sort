#include <stdio.h>

#define THRESHOLD 4

/* Insertion Sort */
void insertionSort(int a[], int low, int high) {
    for (int i = low + 1; i <= high; i++) {
        int key = a[i];
        int j = i - 1;

        while (j >= low && a[j] > key) {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }
}

/* Merge two sorted subarrays */
void merge(int a[], int low, int mid, int high) {
    int i = low;
    int j = mid + 1;
    int k = 0;

    int temp[high - low + 1];

    while (i <= mid && j <= high) {
        if (a[i] <= a[j]) {
            temp[k++] = a[i++];
        } else {
            temp[k++] = a[j++];
        }
    }

    while (i <= mid) {
        temp[k++] = a[i++];
    }

    while (j <= high) {
        temp[k++] = a[j++];
    }

    for (i = low, k = 0; i <= high; i++, k++) {
        a[i] = temp[k];
    }
}

/* Hybrid Merge Sort */
void hybridMergeSort(int a[], int low, int high) {
    if (low >= high)
        return;

    /* Use Insertion Sort for small subarrays */
    if ((high - low + 1) <= THRESHOLD) {
        insertionSort(a, low, high);
        return;
    }

    int mid = (low + high) / 2;

    hybridMergeSort(a, low, mid);
    hybridMergeSort(a, mid + 1, high);

    merge(a, low, mid, high);
}

/* Standard Merge Sort */
void standardMergeSort(int a[], int low, int high) {
    if (low >= high)
        return;

    int mid = (low + high) / 2;

    standardMergeSort(a, low, mid);
    standardMergeSort(a, mid + 1, high);

    merge(a, low, mid, high);
}

void display(int a[], int n) {
    for (int i = 0; i < n; i++) {
        printf("%d", a[i]);

        if (i < n - 1)
            printf(",");
    }
    printf("\n");
}

int main() {
    int n;

    printf("Enter N: ");
    scanf("%d", &n);

    int a[n], hybrid[n], standard[n];

    printf("Enter array elements:\n");

    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);

        hybrid[i] = a[i];
        standard[i] = a[i];
    }

    /* Hybrid Merge Sort */
    hybridMergeSort(hybrid, 0, n - 1);

    /* Standard Merge Sort */
    standardMergeSort(standard, 0, n - 1);

    printf("\nHybrid Merge Sort Result : ");
    display(hybrid, n);

    printf("Standard Merge Sort Result : ");
    display(standard, n);

    return 0;
}
